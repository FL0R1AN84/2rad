<?php
/**
 * Local secrets, loaded (if present) by api/providers.php before the
 * provider config. Copy this file to secrets.local.php (same directory)
 * and fill in real values — that filename is git-ignored so secrets never
 * get committed.
 *
 * Only needed if your hosting doesn't let you set real PHP-FPM/webserver
 * environment variables (see README.md for the preferred Plesk approach).
 */

putenv('MOBIDROM_GBFS_CLIENT_SECRET=REPLACE_ME');

